<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#07110B"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="7dp"
        android:paddingRight="7dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@drawable/scanner_shell">

        <!-- Physical-scanner-inspired top: antenna, dual knobs and status strip -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="76dp"
            android:gravity="bottom|center_horizontal" android:orientation="horizontal"
            android:paddingBottom="4dp">
            <TextView android:layout_width="34dp" android:layout_height="74dp"
                android:background="@drawable/scanner_antenna" android:gravity="center"
                android:text=" " android:textColor="#65FF82" android:textSize="55sp"
                android:contentDescription="Decorative scanner antenna" />
            <TextView android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="match_parent" android:gravity="bottom|center"
                android:text="SCANNERZ NETWORK\nCreated by AaronzNetworking" android:textStyle="bold"
                android:textColor="#65FF82" android:textSize="14sp"
                android:fontFamily="monospace" />
            <TextView android:layout_width="60dp" android:layout_height="60dp"
                android:layout_marginEnd="8dp" android:gravity="center"
                android:background="@drawable/scanner_knob" android:text="VOL\n●"
                android:textColor="#D9FFE0" android:textSize="15sp"
                android:contentDescription="Volume knob decoration" />
            <TextView android:layout_width="60dp" android:layout_height="55dp"
                android:gravity="center" android:background="@drawable/scanner_knob"
                android:text="SQL\n●" android:textColor="#D9FFE0"
                android:textSize="15sp" android:contentDescription="Squelch knob decoration" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="SCANNERZ NETWORK   •   DIGITAL RECEIVER   •   v2.0.0"
            android:gravity="center" android:textColor="#65FF82"
            android:textSize="11sp" android:fontFamily="monospace"
            android:padding="9dp" android:background="#102A16" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/scanner_lcd_frame">

            <TextView
                android:id="@+id/lcdMonitorHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="● LIVE MONITOR  /  SCANNING"
                android:textColor="#6CFF88"
                android:textStyle="bold"
                android:textSize="12sp"
                android:fontFamily="monospace" />

            <LinearLayout
                android:id="@+id/lcdLiveContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <TextView android:id="@+id/status"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Ready" android:textColor="#8EBF98"
                android:textSize="12sp" android:fontFamily="monospace"
                android:paddingTop="4dp" />

            <TextView
                android:id="@+id/nowPlaying"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SCANNING…"
                android:textColor="#65FF82"
                android:textSize="23sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:paddingTop="8dp" />

            <TextView
                android:id="@+id/details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#9BC8A6"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:paddingTop="6dp" />

            <TextView android:id="@+id/lcdListenerStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Listeners: --   Scanners: --"
                android:textColor="#8EBF98"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:paddingTop="8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lcdPageContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Scanner face: real navigation buttons, preserved IDs and listeners -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="10dp" android:gravity="center_vertical">
            <LinearLayout android:layout_width="48dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:background="#17391E">
                <Button android:id="@+id/volumeUpButton" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="▲" android:textSize="18sp" android:textColor="#65FF82" android:backgroundTint="#17391E" android:contentDescription="Increase VOL" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="VOL" android:gravity="center" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" />
                <Button android:id="@+id/volumeDownButton" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="▼" android:textSize="18sp" android:textColor="#65FF82" android:backgroundTint="#17391E" android:contentDescription="Decrease VOL" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/startButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp" android:layout_margin="2dp" android:minWidth="0dp" android:minHeight="48dp" android:paddingLeft="1dp" android:paddingRight="1dp" android:text="POWER" android:textAllCaps="false" android:textSize="10sp" android:maxLines="2" android:gravity="center" android:textStyle="bold" android:textColor="#D9FFE0" android:background="@drawable/scanner_key" android:backgroundTint="@null" app:backgroundTint="@null" />
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/scanDisplayButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp" android:layout_margin="2dp" android:minWidth="0dp" android:minHeight="48dp" android:paddingLeft="1dp" android:paddingRight="1dp" android:text="SCAN" android:textAllCaps="false" android:textSize="10sp" android:maxLines="2" android:gravity="center" android:textStyle="bold" android:textColor="#D9FFE0" android:background="@drawable/scanner_key" android:backgroundTint="@null" app:backgroundTint="@null" />
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/talkgroupButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp" android:layout_margin="2dp" android:minWidth="0dp" android:minHeight="48dp" android:paddingLeft="1dp" android:paddingRight="1dp" android:text="TGIDs" android:textAllCaps="false" android:textSize="10sp" android:maxLines="2" android:gravity="center" android:textStyle="bold" android:textColor="#D9FFE0" android:background="@drawable/scanner_key" android:backgroundTint="@null" app:backgroundTint="@null" />
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/transcriptsNav" android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp" android:layout_margin="2dp" android:minWidth="0dp" android:minHeight="48dp" android:paddingLeft="1dp" android:paddingRight="1dp" android:text="TEXT" android:textAllCaps="false" android:textSize="10sp" android:maxLines="2" android:gravity="center" android:textStyle="bold" android:textColor="#D9FFE0" android:background="@drawable/scanner_key" android:backgroundTint="@null" app:backgroundTint="@null" />
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/announcementsNav" android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp" android:layout_margin="2dp" android:minWidth="0dp" android:minHeight="48dp" android:paddingLeft="1dp" android:paddingRight="1dp" android:text="NEWS" android:textAllCaps="false" android:textSize="10sp" android:maxLines="2" android:gravity="center" android:textStyle="bold" android:textColor="#D9FFE0" android:background="@drawable/scanner_key" android:backgroundTint="@null" app:backgroundTint="@null" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/recentCallsNav" android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp" android:layout_margin="2dp" android:minWidth="0dp" android:minHeight="48dp" android:paddingLeft="1dp" android:paddingRight="1dp" android:text="RECENT" android:textAllCaps="false" android:textSize="10sp" android:maxLines="2" android:gravity="center" android:textStyle="bold" android:textColor="#D9FFE0" android:background="@drawable/scanner_key" android:backgroundTint="@null" app:backgroundTint="@null" />
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/weatherNav" android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp" android:layout_margin="2dp" android:minWidth="0dp" android:minHeight="48dp" android:paddingLeft="1dp" android:paddingRight="1dp" android:text="WX" android:textAllCaps="false" android:textSize="10sp" android:maxLines="2" android:gravity="center" android:textStyle="bold" android:textColor="#D9FFE0" android:background="@drawable/scanner_key" android:backgroundTint="@null" app:backgroundTint="@null" />
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/alertsNav" android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp" android:layout_margin="2dp" android:minWidth="0dp" android:minHeight="48dp" android:paddingLeft="1dp" android:paddingRight="1dp" android:text="ALERTS" android:textAllCaps="false" android:textSize="10sp" android:maxLines="2" android:gravity="center" android:textStyle="bold" android:textColor="#D9FFE0" android:background="@drawable/scanner_key" android:backgroundTint="@null" app:backgroundTint="@null" />
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/feedQuickNav" android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp" android:layout_margin="2dp" android:minWidth="0dp" android:minHeight="48dp" android:paddingLeft="1dp" android:paddingRight="1dp" android:text="FEEDS" android:textAllCaps="false" android:textSize="10sp" android:maxLines="2" android:gravity="center" android:textStyle="bold" android:textColor="#D9FFE0" android:background="@drawable/scanner_key" android:backgroundTint="@null" app:backgroundTint="@null" />
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/settingsNav" android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp" android:layout_margin="2dp" android:minWidth="0dp" android:minHeight="48dp" android:paddingLeft="1dp" android:paddingRight="1dp" android:text="SETUP" android:textAllCaps="false" android:textSize="10sp" android:maxLines="2" android:gravity="center" android:textStyle="bold" android:textColor="#D9FFE0" android:background="@drawable/scanner_key" android:backgroundTint="@null" app:backgroundTint="@null" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="48dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:background="#17391E">
                <Button android:id="@+id/squelchUpButton" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="▲" android:textSize="18sp" android:textColor="#65FF82" android:backgroundTint="#17391E" android:contentDescription="Increase SQL" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SQL" android:gravity="center" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" />
                <Button android:id="@+id/squelchDownButton" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="▼" android:textSize="18sp" android:textColor="#65FF82" android:backgroundTint="#17391E" android:contentDescription="Decrease SQL" />
            </LinearLayout>
        </LinearLayout>
        <Button android:id="@+id/feedButton" android:layout_width="match_parent"
            android:layout_height="48dp" android:text="FEED: LOADING…" android:textColor="#D9FFE0"
            android:backgroundTint="#173D20" android:visibility="gone" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/wxQuickButton" android:layout_width="match_parent" android:layout_height="40dp" android:text="WX - NOAA RADIO" android:textColor="#65FF82" android:background="@drawable/scanner_key" android:backgroundTint="@null" app:backgroundTint="@null" />
        <!-- Audio activity meter sits directly above the speaker grille. -->
        <net.aaronznetworking.scanner.ScannerAudioMeter
            android:id="@+id/scannerAudioMeter"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:contentDescription="Scanner audio activity meter" />
        <TextView android:layout_width="match_parent" android:layout_height="96dp"
            android:gravity="center" android:text="● ● ● ● ● ● ● ● ● ● ● ● ● ● ●\n● ● ● ● ● ● ● ● ● ● ● ● ● ● ●\n● ● ● ● ● ● ● ● ● ● ● ● ● ● ●\n● ● ● ● ● ● ● ● ● ● ● ● ● ● ●"
            android:textSize="17sp" android:letterSpacing="0.12" android:textColor="#344B39"
            android:background="@drawable/scanner_speaker" android:layout_marginTop="12dp"
            android:padding="10dp"
            android:contentDescription="Scanner speaker grille" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Scannerz Network  •  Created by AaronzNetworking  •  v2.0.0"
            android:gravity="center" android:padding="10dp" android:textSize="12sp"
            android:textColor="#65FF82" android:background="#102A16" />
        <LinearLayout
            android:id="@+id/weatherSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="18dp"
            android:background="#0A1B10">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="☁ LOCAL WEATHER"
                android:textColor="#6CFF88"
                android:textStyle="bold"
                android:textSize="13sp"
                android:fontFamily="monospace" />

            <Button
                android:id="@+id/weatherCollapse"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="EXPAND"
                android:textSize="10sp"
                android:textColor="#D8F7DE"
                android:backgroundTint="#173D20"
                android:layout_marginTop="8dp" />

            <CheckBox
                android:id="@+id/weatherAutoExpand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Auto-expand when a weather alert is active"
                android:textColor="#D8F7DE"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/weatherLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Choose a weather location"
                android:textColor="#A8CDB0"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:paddingTop="8dp" />

            <TextView
                android:id="@+id/weatherCurrent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--°   Waiting for location"
                android:textColor="#E9FFF0"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:paddingTop="8dp" />

            <TextView
                android:id="@+id/weatherDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#9BC8A6"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:paddingTop="5dp" />

            <TextView
                android:id="@+id/weatherAlertsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Weather alerts are disabled."
                android:textColor="#6CFF88"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📍 WEATHER LOCATION"
                android:textColor="#A8CDB0"
                android:textStyle="bold"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:paddingTop="8dp" />

            <RadioGroup
                android:id="@+id/weatherLocationGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp">

                <RadioButton
                    android:id="@+id/weatherUseLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Use My Location"
                    android:textColor="#D8F7DE"
                    android:fontFamily="monospace" />

                <RadioButton
                    android:id="@+id/weatherUseZip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ZIP Code"
                    android:textColor="#D8F7DE"
                    android:fontFamily="monospace" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/weatherZipRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone"
                android:paddingTop="6dp">

                <EditText
                    android:id="@+id/weatherZipCode"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:hint="ZIP"
                    android:maxLength="5"
                    android:inputType="number"
                    android:singleLine="true"
                    android:textColor="#E9FFF0"
                    android:textColorHint="#6F8E76"
                    android:backgroundTint="#6CFF88"
                    android:fontFamily="monospace" />

                <Button
                    android:id="@+id/weatherZipSet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SET"
                    android:textStyle="bold"
                    android:textColor="#D8F7DE"
                    android:backgroundTint="#173D20"
                    android:layout_marginLeft="8dp" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/weatherAlertsEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enable Local Weather Alerts"
                android:textColor="#D8F7DE"
                android:fontFamily="monospace"
                android:paddingTop="8dp" />

            <CheckBox
                android:id="@+id/weatherAlertSoundEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Alert Sound"
                android:textColor="#D8F7DE"
                android:fontFamily="monospace" />

            <CheckBox
                android:id="@+id/weatherAlertSpeechEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Read Weather Alerts Aloud"
                android:textColor="#D8F7DE"
                android:fontFamily="monospace" />

            <Button
                android:id="@+id/weatherRadioButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NOAA WEATHER RADIO UNAVAILABLE"
                android:textStyle="bold"
                android:textColor="#D8F7DE"
                android:backgroundTint="#173D20"
                android:layout_marginTop="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Weather alerts stay on screen with their full official details. Alert sound and read-aloud are optional. NOAA Weather Radio is manual only and never takes over the scanner automatically."
                android:textColor="#6F8E76"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:paddingTop="6dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/announcementSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="18dp"
            android:background="#2B2410"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📢 ANNOUNCEMENTS"
                    android:textColor="#FFD166"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:fontFamily="monospace" />

                <Button
                    android:id="@+id/announcementCollapse"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="COLLAPSE"
                    android:textSize="10sp"
                    android:textColor="#FFF1C7"
                    android:backgroundTint="#4B3A13" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/announcementContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/announcementText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFF1C7"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="3dp"
                    android:paddingTop="8dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/transcriptSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="RECENT AI TRANSCRIPTS"
                    android:textColor="#6CFF88"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <Button
                    android:id="@+id/transcriptCollapse"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="COLLAPSE"
                    android:textSize="10sp"
                    android:textColor="#D8F7DE"
                    android:backgroundTint="#173D20" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/transcriptContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/transcript"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Waiting for completed transcripts…"
                    android:textColor="#E9FFF0"
                    android:textSize="15sp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="3dp"
                    android:paddingTop="8dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/alertsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ACTIVE ALERTS"
                    android:textColor="#FFB04A"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <Button
                    android:id="@+id/alertsCollapse"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="COLLAPSE"
                    android:textSize="10sp"
                    android:textColor="#FFE0B0"
                    android:backgroundTint="#4A2B0A" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/alertsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/alerts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No active major incidents"
                    android:textColor="#FFE0B0"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="3dp"
                    android:paddingTop="8dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/recentCallsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="RECENT CALLS"
                    android:textColor="#6CFF88"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <Button
                    android:id="@+id/recentCallsCollapse"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="COLLAPSE"
                    android:textSize="10sp"
                    android:textColor="#D8F7DE"
                    android:backgroundTint="#173D20" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/recentCallsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/recentCalls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No calls yet."
                    android:textColor="#E9FFF0"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="3dp"
                    android:paddingTop="8dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/listeners"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Listeners: --     Peak: --"
            android:textColor="#9BC8A6"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:gravity="center_horizontal"
            android:paddingTop="12dp" />

    </LinearLayout>
</ScrollView>
