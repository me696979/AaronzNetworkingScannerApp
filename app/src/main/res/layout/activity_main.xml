<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TRI-STATE SCANNER" android:textSize="26sp" android:textStyle="bold" />
  <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ready" android:textSize="16sp" android:paddingTop="8dp" />
  <Button android:id="@+id/startButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="START SCANNER" android:layout_marginTop="18dp" />
  <TextView android:id="@+id/nowPlaying" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Scanning…" android:textSize="21sp" android:textStyle="bold" android:paddingTop="24dp" />
  <TextView android:id="@+id/details" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="6dp" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="AI TRANSCRIPT" android:textStyle="bold" android:paddingTop="24dp" />
  <TextView android:id="@+id/transcript" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Waiting for call…" android:paddingTop="6dp" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ACTIVE ALERTS" android:textStyle="bold" android:paddingTop="24dp" />
  <TextView android:id="@+id/alerts" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No active major incidents" android:paddingTop="6dp" />
  <TextView android:id="@+id/listeners" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Listeners: --   Peak: --" android:paddingTop="24dp" />
 </LinearLayout>
</ScrollView>
